# Where sign-ups go. Any URL that accepts a JSON POST works:
# Zapier / Make / n8n webhook, a Google Apps Script web app, Formspree, your own API...
# Body sent: { email, site, cms, role, source, createdAt }
WAITLIST_WEBHOOK_URL=

# Optional: sent as "Authorization: Bearer <value>" to the webhook.
WAITLIST_WEBHOOK_TOKEN=

# Without WAITLIST_WEBHOOK_URL, `next dev` appends sign-ups to .data/waitlist.jsonl
# and production returns 503, so no email is silently dropped.
