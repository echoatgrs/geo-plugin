{
  "name": "payload-plugin-geo",
  "version": "0.1.0",
  "description": "Headless GEO for Payload CMS: AI crawler logs, llms.txt and an AI visibility dashboard.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "payload",
    "payload-plugin",
    "geo",
    "llms.txt",
    "ai-crawler",
    "gptbot"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@headless-geo/core": "0.1.0",
    "@headless-geo/dashboard": "0.1.0"
  },
  "peerDependencies": {
    "payload": "^3.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "payload": "^3.92.1"
  }
}
