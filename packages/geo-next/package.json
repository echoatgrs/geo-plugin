{
  "name": "@garus-ltd/geo-next",
  "version": "0.1.0",
  "description": "Frontend SDK for Headless GEO: Next.js proxy / middleware that reports AI crawler visits to your CMS.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/echoatgrs/geo-plugin.git",
    "directory": "packages/geo-next"
  },
  "homepage": "https://github.com/echoatgrs/geo-plugin#readme",
  "bugs": "https://github.com/echoatgrs/geo-plugin/issues",
  "keywords": [
    "geo",
    "llms.txt",
    "ai-crawler",
    "headless-cms"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@garus-ltd/geo-core": "0.1.0"
  },
  "module": "./dist/index.js",
  "publishConfig": {
    "access": "public"
  }
}
