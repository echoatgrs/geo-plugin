{
  "name": "strapi-plugin-geo",
  "version": "0.4.0",
  "description": "Headless GEO for Strapi 5: AI crawler logs, llms.txt and an AI visibility dashboard.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/echoatgrs/geo-plugin.git",
    "directory": "packages/strapi-plugin-geo"
  },
  "homepage": "https://github.com/echoatgrs/geo-plugin#readme",
  "bugs": "https://github.com/echoatgrs/geo-plugin/issues",
  "keywords": [
    "strapi",
    "strapi-plugin",
    "geo",
    "llms.txt",
    "ai-crawler",
    "gptbot"
  ],
  "type": "commonjs",
  "strapi": {
    "kind": "plugin",
    "name": "geo",
    "displayName": "Headless GEO",
    "description": "AI crawler logs for headless sites."
  },
  "main": "./dist/server/index.js",
  "types": "./dist/server/index.d.ts",
  "exports": {
    "./strapi-admin": {
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/index.d.ts",
      "require": "./strapi-server.js",
      "default": "./strapi-server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "strapi-server.js",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@garus-ltd/geo-core": "0.4.0",
    "@garus-ltd/geo-dashboard": "0.4.0"
  },
  "peerDependencies": {
    "@strapi/strapi": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0"
  }
}
